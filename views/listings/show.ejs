<% layout("/layouts/boilerplate.ejs") %>


<body>
    
<div class="row">
    <div class="col-6 offset-2">
        <span class="fs-3"><%= showListing.title %> </span>
       <div class="card">
        <img src="<%= showListing.image.url %>" alt="Listing_Image" class=""height="300vh">
        <div class="card-body">
            <div class="mt-2"><%=showListing.description %></div>
            <div class="mt-2"><%=showListing.price.toLocaleString("en-IN") %></div>
            <div class="mt-2"><%=showListing.location %></div>
            <div class="mt-2"><%=showListing.country %></div>
        </div>
       </div> 
       <div class="row d-flex m-0">
       <div class="col-md-3 me-0">
<a href="/listings/<%= showListing._id %>/edit"><button class="btn btn-success">Edit Listing</button></a><br><br>
       </div>
       <div class="col-md-8">
<form action="/listings/<%= showListing._id %>?_method=DELETE" method="post"><button class="btn btn-danger">Delete Listing</button></form>
       </div>
</div>
</body>
